# Socket.io Server URL
# Leave unset for local dev: the Vite dev server proxies /socket.io to localhost:8080,
# which also works when the dev server is reached through a tunnel (e.g. ngrok).
# Set it for production builds, where the client and server are hosted separately.
# VITE_SOCKET_URL=http://localhost:8080

# MapTiler API Key (for map rendering)
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here
